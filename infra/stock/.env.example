# 종목 적재 (infra/stock/compose.yaml). 서비스(기본) EC2.
# 실제 값은 서버의 .env 에만 둔다 — 커밋 금지, mode 0600.

# DB — infra/db/.env · infra/service/.env 와 같은 값이어야 한다.
POSTGRES_DB=wikipulse
POSTGRES_USER=
POSTGRES_PASSWORD=

# 🔴 GMS 키. embed 단계에서만 쓴다. universe·summaries 는 없어도 돈다.
#    팀 키 만료 2026-10-02 — 그 전에 적재를 끝낸다.
#
# ⚠️ 이름은 GMS_KEY 다 (infra/service/.env 와 같다). stock/embed.py 만 GMS_API_KEY 를
#    읽는데 compose 가 이어 붙인다 — 키를 두 군데 적지 않게 하려는 것이다.
GMS_KEY=
GMS_BASE_URL=https://llm-gateway.example.com/api.openai.com/v1

# 빌드 컨텍스트. EC2 에서는 저장소를 클론하지 않고 `data-pipeline/` 을 여기로 복사한다
# — infra/pipeline 이 데이터 EC2 에서 쓰는 방식과 같다(PIPELINE_APP_DIR=.../pipeline/app).
# 로컬에서 돌릴 때는 `../../data-pipeline` 를 그대로 쓴다.
STOCK_APP_DIR=/home/ubuntu/infra/stock/app
