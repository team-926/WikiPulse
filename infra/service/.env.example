# EC2 서비스 스택 (infra/service/compose.yaml).
# 🔴 GMS_KEY 는 저장소에 넣지 않는다 (팀 지침 문서). 서버의 .env 에만 둔다.

# DB — infra/db/.env 와 같은 값이어야 한다.
POSTGRES_DB=wikipulse
POSTGRES_USER=
POSTGRES_PASSWORD=

# 백엔드가 쓰는 애플리케이션 롤. 마이그레이션 적용 시
#   python db/apply_migrations.py --grant-role "$APP_DB_ROLE"
# 로 권한을 준다 (WP-133).
APP_DB_ROLE=user_wikipulse

# 프론트 빌드 시점 값
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api/v1

# Wikimedia 예절 — 연락처 없는 User-Agent 는 차단된다
CONTACT_EMAIL=
WIKIS=enwiki

# GMS 게이트웨이 키
GMS_KEY=

# 매칭·검증 워커 스위치. 켜기 전에 종목 임베딩이 전량 적재돼 있어야 한다.
WIKIPULSE_MATCHING_SCHEDULER_ENABLED=false
WIKIPULSE_MATCHING_VERIFICATION_ENABLED=false
# 이슈 요약 writer·상태 전이 워커(WP-119). 검증과 같은 GMS 키를 쓴다.
WIKIPULSE_MATCHING_SUMMARY_ENABLED=false

# 🔴 한 폴에 집을 클러스터 수. 기본 20.
#    LLM 검증은 **후보 하나당 1회** 호출이라(`LlmVerifier`) 클러스터 20개면 수백 회다.
#    2026-09-20 실측 환산: LLM 약 41 크레딧/회 · 임베딩 0.04/건. 팀 키는 100,000 이고
#    만료 2026-10-02 다 — 미처리 클러스터가 수천 개 쌓인 상태에서 기본값으로 켜면
#    하루 만에 예산을 태운다. 부트스트랩에서는 작게 잡고 잔액을 보며 늘린다.
#    (`GET gmsapi/key-info` 로 잔액 확인)
WIKIPULSE_MATCHING_SCHEDULER_BATCHSIZE=20
WIKIPULSE_MATCHING_VERIFICATION_BATCHSIZE=20
WIKIPULSE_MATCHING_SUMMARY_BATCHSIZE=20

# 문서 표시용 한국어 제목 채우기 워커 (WP-205). GMS 와 무관하고 크레딧을 안 쓴다.
# 🔴 켜는 것이 곧 백필이다 — cluster_member 에 편입된 enwiki 문서를 훑어 title_ko 를 채운다.
#    끄면 화면이 영문 제목으로 떨어질 뿐 기능이 깨지지는 않는다.
# 폴당 위키 요청 수 = BATCHSIZE / 50 (langlinks 는 한 요청에 제목 50개가 상한).
WIKIPULSE_PAGETITLE_ENABLED=false
WIKIPULSE_PAGETITLE_BATCHSIZE=500
